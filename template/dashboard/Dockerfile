# The dashboard is standard library only, so this image installs nothing: no
# pip, no npm, no build stage. The page is a single .html file checked into the
# repo and served as-is, which is the whole reason there is no node here.
#
# Built for Oracle Cloud Always Free (Ampere A1, ARM64); python:3.11-slim has
# native arm64 images, so it builds on the VM without emulation.
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=America/New_York
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# backtests.json is generated by make_backtests.py on a machine that has pandas
# and the trade logs. It ships prebuilt because this image has neither.
COPY dashboard/server.py dashboard/index.html dashboard/backtests.json /app/dashboard/

ENV BOT_STATE_DIR=/app/state DASHBOARD_HOST=0.0.0.0 DASHBOARD_PORT=8080
EXPOSE 8080

# Python rather than curl, so the image needs no extra package. /healthz is
# deliberately cheap: it reports liveness without reading every state file.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import urllib.request,sys;\
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz',timeout=4).status==200 else 1)"]

# Nothing is written by this process. It reads the state directory and serves it.
USER nobody
CMD ["python3", "/app/dashboard/server.py"]
